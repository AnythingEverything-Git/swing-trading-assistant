# Example environment variables. Do NOT store real secrets here.
# Expected local configuration example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/swing_trading_assistant
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/swing_trading_assistant
ENVIRONMENT=development

# Upstox historical candle provider (Bearer access token — no in-app OAuth).
# Demo market-data timeframe: 1d
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_ACCESS_TOKEN=

# Amazon SES (SMTP). Fill SMTP username/password from the SES console.
EMAIL_PROVIDER=ses
AWS_SES_REGION=ap-south-1
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USE_TLS=true
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=

# Research insights (optional Gemini Flash). Keep template until key is set.
NARRATIVE_PROVIDER=template
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
