# Example environment variables — LOCAL DEV only (demo). Do NOT store real secrets.
# AWS release uses ops/vps/env.vps.example → /opt/tradepilot/.env (upstox, production).

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/swingdb
ENVIRONMENT=development

# Local coding stays on demo. Live Upstox belongs on AWS production only.
MARKET_DATA_SOURCE=demo
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_ACCESS_TOKEN=

# Keep refresh light locally (or disable). Full NSE_ALL ingest is AWS/cron.
MARKET_DATA_REFRESH_ENABLED=false
MARKET_DATA_REFRESH_TIME=16:15
MARKET_DATA_REFRESH_UNIVERSE=NIFTY_50
MARKET_DATA_REFRESH_RUN_ON_STARTUP=false
INTRADAY_1M_REFRESH_ENABLED=false
INTRADAY_1M_REFRESH_INTERVAL_SEC=300
INTRADAY_1M_REFRESH_UNIVERSE=NIFTY_50
INTRADAY_1M_REFRESH_LIMIT=50

EMAIL_PROVIDER=ses
AWS_SES_REGION=ap-south-1
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USE_TLS=true
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=

FRONTEND_BASE_URL=http://127.0.0.1:5173

NARRATIVE_PROVIDER=template
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
