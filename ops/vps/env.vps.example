# Copy to VPS as `.env` (never commit real secrets).
# AWS RELEASE / production — live Upstox only. NEVER set MARKET_DATA_SOURCE=demo here.

ENVIRONMENT=production
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+psycopg://postgres:change-me-strong-password@postgres:5432/swingdb

MARKET_DATA_SOURCE=upstox
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_ACCESS_TOKEN=

MARKET_DATA_REFRESH_ENABLED=true
MARKET_DATA_REFRESH_TIME=16:15
MARKET_DATA_REFRESH_UNIVERSE=NSE_ALL
MARKET_DATA_REFRESH_RUN_ON_STARTUP=false

INTRADAY_1M_REFRESH_ENABLED=true
INTRADAY_1M_REFRESH_INTERVAL_SEC=600
INTRADAY_1M_REFRESH_UNIVERSE=NSE_ALL
INTRADAY_1M_REFRESH_LIMIT=3000

API_PORT=8001
FRONTEND_BASE_URL=http://13.235.110.243

EMAIL_PROVIDER=ses
AWS_SES_REGION=ap-south-1
NARRATIVE_PROVIDER=template
